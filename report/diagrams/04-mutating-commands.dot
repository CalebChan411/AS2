digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.8", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Five undoable commands and retained targets\nSolid hollow triangle: inheritance | Dashed hollow triangle: realization\nSolid arrow: stored reference | Dashed open arrow: dependency / create"];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.75, color="#334155"];
AddDriverCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>AddDriverCommand</B></TD></TR><TR><TD ALIGN="LEFT">-driverFactory : DriverFactory<BR ALIGN="LEFT"/>-fleetFactory : FleetFactory<BR ALIGN="LEFT"/>-driverID : String<BR ALIGN="LEFT"/>-driverName : String<BR ALIGN="LEFT"/>-role : int<BR ALIGN="LEFT"/>-fleet : VehicleFleet<BR ALIGN="LEFT"/>-driver : Driver<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+AddDriverCommand(manager : FleetManager, factory : DriverFactory, driverID : String, driverName : String, role : int)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
