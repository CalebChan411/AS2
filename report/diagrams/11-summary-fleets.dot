digraph G {
graph [rankdir=TB, bgcolor="white", nodesep=.35, ranksep=.6, pad=.2, fontname="DejaVu Sans", fontsize=12, labelloc=t, label="Fleet creation and extension\nSummary view — selected members and relationships"];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=.7];
FleetFactoryRegistry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dcecf8"><B>FleetFactoryRegistry</B></TD></TR><TR><TD ALIGN="LEFT">-factories</TD></TR></TABLE>>];
FleetFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dcecf8"><B>«interface»<BR/>FleetFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createFleet(id)</TD></TR></TABLE>>];
DeliveryVanFleetFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dcecf8"><B>DeliveryVanFleetFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createFleet(id)</TD></TR></TABLE>>];
RefrigeratedTruckFleetFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dcecf8"><B>RefrigeratedTruckFleetFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createFleet(id)</TD></TR></TABLE>>];
DeliveryVanFleet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dcecf8"><B>DeliveryVanFleet</B></TD></TR><TR><TD ALIGN="LEFT">+showFleet()</TD></TR></TABLE>>];
RefrigeratedTruckFleet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dcecf8"><B>RefrigeratedTruckFleet</B></TD></TR><TR><TD ALIGN="LEFT">+showFleet()</TD></TR></TABLE>>];
VehicleFleet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dcecf8"><B>VehicleFleet</B></TD></TR><TR><TD ALIGN="LEFT">-drivers</TD></TR><TR><TD ALIGN="LEFT">+showFleet() {abstract}</TD></TR></TABLE>>];
Driver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dcecf8"><B>Driver</B></TD></TR><TR><TD ALIGN="LEFT">-driverID / driverName / role</TD></TR></TABLE>>];
FleetFactoryRegistry -> FleetFactory [arrowhead=open,label="factories"];
DeliveryVanFleetFactory -> FleetFactory [style=dashed,arrowhead=empty];
RefrigeratedTruckFleetFactory -> FleetFactory [style=dashed,arrowhead=empty];
DeliveryVanFleetFactory -> DeliveryVanFleet [style=dashed,arrowhead=open,label="«create»"];
RefrigeratedTruckFleetFactory -> RefrigeratedTruckFleet [style=dashed,arrowhead=open,label="«create»"];
DeliveryVanFleet -> VehicleFleet [arrowhead=empty];
RefrigeratedTruckFleet -> VehicleFleet [arrowhead=empty];
VehicleFleet -> Driver [arrowhead=open,label="drivers 0..*"];
{rank=same; DeliveryVanFleetFactory; RefrigeratedTruckFleetFactory;}
{rank=same; DeliveryVanFleet; RefrigeratedTruckFleet;}
}