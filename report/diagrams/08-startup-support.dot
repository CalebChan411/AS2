digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.8", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Startup, input and command dispatch\nSolid hollow triangle: inheritance | Dashed hollow triangle: realization\nSolid arrow: stored reference | Dashed open arrow: dependency / create"];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.75, color="#334155"];
CommandExecutionException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>CommandExecutionException</B></TD></TR><TR><TD ALIGN="LEFT">+CommandExecutionException(message : String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CommandFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8">«interface»<BR/><B>CommandFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createCommand() : Command<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CommandFactoryRegistry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>CommandFactoryRegistry</B></TD></TR><TR><TD ALIGN="LEFT">-factories : Map&lt;String, CommandFactory&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+CommandFactoryRegistry()<BR ALIGN="LEFT"/>+registerFactory(code : String, factory : CommandFactory) : void<BR ALIGN="LEFT"/>+getFactory(code : String) : CommandFactory<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CommandHistory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>CommandHistory</B></TD></TR><TR><TD ALIGN="LEFT">-undoStack : Stack&lt;Command&gt;<BR ALIGN="LEFT"/>-redoStack : Stack&lt;Command&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+CommandHistory()<BR ALIGN="LEFT"/>+record(command : Command) : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+showUndoRedoList() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CommandInvoker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>CommandInvoker</B></TD></TR><TR><TD ALIGN="LEFT">-history : CommandHistory<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+CommandInvoker()<BR ALIGN="LEFT"/>+CommandInvoker(history : CommandHistory)<BR ALIGN="LEFT"/>+execute(command : Command) : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+showUndoRedoList() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ConsoleInput [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>ConsoleInput</B></TD></TR><TR><TD ALIGN="LEFT">-scanner : Scanner<BR ALIGN="LEFT"/>-interactive : boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ConsoleInput(scanner : Scanner, interactive : boolean)<BR ALIGN="LEFT"/>+readLine(prompt : String) : String<BR ALIGN="LEFT"/>+readInt(prompt : String) : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FleetManager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>FleetManager</B></TD></TR><TR><TD ALIGN="LEFT">-fleets : List&lt;VehicleFleet&gt;<BR ALIGN="LEFT"/>-currentFleet : VehicleFleet<BR ALIGN="LEFT"/>-fleetFactories : Map&lt;VehicleFleet, FleetFactory&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+FleetManager()<BR ALIGN="LEFT"/>+addFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+removeFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+addFleet(fleet : VehicleFleet, factory : FleetFactory) : void<BR ALIGN="LEFT"/>+getFleetFactory(fleet : VehicleFleet) : FleetFactory<BR ALIGN="LEFT"/>+getFleets() : List&lt;VehicleFleet&gt;<BR ALIGN="LEFT"/>+findFleet(fleetID : String) : VehicleFleet<BR ALIGN="LEFT"/>+setCurrentFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+getCurrentFleet() : VehicleFleet<BR ALIGN="LEFT"/>+getFleetCount() : int<BR ALIGN="LEFT"/>+hasFleet(fleetID : String) : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>Main</B></TD></TR><TR><TD ALIGN="LEFT">-interactive : boolean {static}<BR ALIGN="LEFT"/>-MENU_PROMPT : String {static, readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+main(args : String[]) : void {static}<BR ALIGN="LEFT"/>-printHeader(manager : FleetManager) : void {static}<BR ALIGN="LEFT"/>-showMenu() : void {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CommandFactoryRegistry -> CommandFactory [arrowhead=open, label="factories", headlabel="0..*", taillabel="0..*", labeldistance=2];
CommandInvoker -> CommandHistory [arrowhead=open, label="history", headlabel="1", taillabel="0..*", labeldistance=2];
CommandInvoker -> CommandHistory [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
FleetManager -> CommandExecutionException [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
Main -> CommandFactoryRegistry [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
Main -> CommandHistory [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
Main -> CommandInvoker [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
Main -> ConsoleInput [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
Main -> FleetManager [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
Main -> CommandFactory [arrowhead=open, style=dashed, label="createCommand()"];
Main -> CommandExecutionException [arrowhead=open, style=dashed, label="catches"];
}