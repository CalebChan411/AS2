digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.8", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Factories for selection, display and history\nSolid hollow triangle: inheritance | Dashed hollow triangle: realization\nSolid arrow: stored reference | Dashed open arrow: dependency / create"];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.75, color="#334155"];
CommandFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8">«interface»<BR/><B>CommandFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createCommand() : Command<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
