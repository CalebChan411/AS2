digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.8", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Command history and per-command mementos\nSolid hollow triangle: inheritance | Dashed hollow triangle: realization\nSolid arrow: stored reference | Dashed open arrow: dependency / create"];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.75, color="#334155"];
BaseCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><I>BaseCommand</I></TD></TR><TR><TD ALIGN="LEFT">+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+isUndoable() : boolean<BR ALIGN="LEFT"/>+execute() : void {abstract}<BR ALIGN="LEFT"/>+displayName() : String {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ChangeNameCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>ChangeNameCommand</B></TD></TR><TR><TD ALIGN="LEFT">-newName : String<BR ALIGN="LEFT"/>-fleet : VehicleFleet<BR ALIGN="LEFT"/>-caretaker : MementoCaretaker<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ChangeNameCommand(manager : FleetManager, newName : String)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Command [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8">«interface»<BR/><B>Command</B></TD></TR><TR><TD ALIGN="LEFT">+execute() : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/>+isUndoable() : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CommandHistory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>CommandHistory</B></TD></TR><TR><TD ALIGN="LEFT">-undoStack : Stack&lt;Command&gt;<BR ALIGN="LEFT"/>-redoStack : Stack&lt;Command&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+CommandHistory()<BR ALIGN="LEFT"/>+record(command : Command) : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+showUndoRedoList() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CommandInvoker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>CommandInvoker</B></TD></TR><TR><TD ALIGN="LEFT">-history : CommandHistory<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+CommandInvoker()<BR ALIGN="LEFT"/>+CommandInvoker(history : CommandHistory)<BR ALIGN="LEFT"/>+execute(command : Command) : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+showUndoRedoList() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Driver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>Driver</B></TD></TR><TR><TD ALIGN="LEFT">-driverID : String<BR ALIGN="LEFT"/>-driverName : String<BR ALIGN="LEFT"/>-role : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+Driver(driverID : String)<BR ALIGN="LEFT"/>+getDriverID() : String<BR ALIGN="LEFT"/>+getRole() : int<BR ALIGN="LEFT"/>+setRole(role : int) : void<BR ALIGN="LEFT"/>+getName() : String<BR ALIGN="LEFT"/>+setName(name : String) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DriverRoleMemento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>DriverRoleMemento</B></TD></TR><TR><TD ALIGN="LEFT">-driver : Driver<BR ALIGN="LEFT"/>-oldRole : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+DriverRoleMemento(driver : Driver)<BR ALIGN="LEFT"/>+restore() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FleetNameMemento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>FleetNameMemento</B></TD></TR><TR><TD ALIGN="LEFT">-fleet : VehicleFleet<BR ALIGN="LEFT"/>-oldName : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+FleetNameMemento(fleet : VehicleFleet)<BR ALIGN="LEFT"/>+restore() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Memento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8">«interface»<BR/><B>Memento</B></TD></TR><TR><TD ALIGN="LEFT">+restore() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MementoCaretaker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>MementoCaretaker</B></TD></TR><TR><TD ALIGN="LEFT">-memento : Memento<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+MementoCaretaker()<BR ALIGN="LEFT"/>+save(memento : Memento) : void<BR ALIGN="LEFT"/>+hasMemento() : boolean<BR ALIGN="LEFT"/>+restore() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ModifyRoleCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>ModifyRoleCommand</B></TD></TR><TR><TD ALIGN="LEFT">-driverID : String<BR ALIGN="LEFT"/>-newRole : int<BR ALIGN="LEFT"/>-fleet : VehicleFleet<BR ALIGN="LEFT"/>-driver : Driver<BR ALIGN="LEFT"/>-caretaker : MementoCaretaker<BR ALIGN="LEFT"/>-fleetFactory : FleetFactory<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ModifyRoleCommand(manager : FleetManager, driverID : String, newRole : int)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
UndoableCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><I>UndoableCommand</I></TD></TR><TR><TD ALIGN="LEFT">#manager : FleetManager<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+UndoableCommand(manager : FleetManager)<BR ALIGN="LEFT"/>+isUndoable() : boolean<BR ALIGN="LEFT"/>+undo() : void {abstract}<BR ALIGN="LEFT"/>+redo() : void {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
VehicleFleet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><I>VehicleFleet</I></TD></TR><TR><TD ALIGN="LEFT">-fleetID : String<BR ALIGN="LEFT"/>-fleetName : String<BR ALIGN="LEFT"/>-drivers : AbstractList<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+VehicleFleet(fleetID : String)<BR ALIGN="LEFT"/>+getFleetID() : String<BR ALIGN="LEFT"/>+getName() : String<BR ALIGN="LEFT"/>+setName(name : String) : void<BR ALIGN="LEFT"/>+addDriver(driver : Driver) : void<BR ALIGN="LEFT"/>+dropDriver(driver : Driver) : void<BR ALIGN="LEFT"/>+getDrivers() : Iterator&lt;Driver&gt;<BR ALIGN="LEFT"/>+updateDriverRole() : void {abstract}<BR ALIGN="LEFT"/>+showFleet() : void {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
BaseCommand -> Command [style=dashed, arrowhead=empty];
ChangeNameCommand -> UndoableCommand [arrowhead=empty];
DriverRoleMemento -> Memento [style=dashed, arrowhead=empty];
FleetNameMemento -> Memento [style=dashed, arrowhead=empty];
ModifyRoleCommand -> UndoableCommand [arrowhead=empty];
UndoableCommand -> BaseCommand [arrowhead=empty];
