CommandHistory -> Command [arrowhead=open, label="redoStack, undoStack", headlabel="0..*", taillabel="0..*", labeldistance=2];
CommandInvoker -> CommandHistory [arrowhead=open, label="history", headlabel="1", taillabel="0..*", labeldistance=2];
DriverRoleMemento -> Driver [arrowhead=open, label="driver", headlabel="1", taillabel="0..*", labeldistance=2];
FleetNameMemento -> VehicleFleet [arrowhead=open, label="fleet", headlabel="1", taillabel="0..*", labeldistance=2];
MementoCaretaker -> Memento [arrowhead=open, label="memento", headlabel="0..1", taillabel="0..*", labeldistance=2];
ModifyRoleCommand -> Driver [arrowhead=open, label="driver", headlabel="0..1", taillabel="0..*", labeldistance=2];
ModifyRoleCommand -> MementoCaretaker [arrowhead=open, label="caretaker", headlabel="1", taillabel="0..1", labeldistance=2];
ModifyRoleCommand -> VehicleFleet [arrowhead=open, label="fleet", headlabel="0..1", taillabel="0..*", labeldistance=2];
VehicleFleet -> Driver [arrowhead=open, label="drivers", headlabel="0..*", taillabel="0..*", labeldistance=2];
ChangeNameCommand -> FleetNameMemento [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
ChangeNameCommand -> MementoCaretaker [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
CommandInvoker -> CommandHistory [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
