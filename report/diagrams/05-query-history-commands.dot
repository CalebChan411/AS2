digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.8", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Six non-undoable commands\nSolid hollow triangle: inheritance | Dashed hollow triangle: realization\nSolid arrow: stored reference | Dashed open arrow: dependency / create"];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.75, color="#334155"];
BaseCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><I>BaseCommand</I></TD></TR><TR><TD ALIGN="LEFT">+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+isUndoable() : boolean<BR ALIGN="LEFT"/>+execute() : void {abstract}<BR ALIGN="LEFT"/>+displayName() : String {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CommandInvoker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>CommandInvoker</B></TD></TR><TR><TD ALIGN="LEFT">-history : CommandHistory<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+CommandInvoker()<BR ALIGN="LEFT"/>+CommandInvoker(history : CommandHistory)<BR ALIGN="LEFT"/>+execute(command : Command) : void<BR ALIGN="LEFT"/>+undo() : void<BR ALIGN="LEFT"/>+redo() : void<BR ALIGN="LEFT"/>+showUndoRedoList() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FleetManager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>FleetManager</B></TD></TR><TR><TD ALIGN="LEFT">-fleets : List&lt;VehicleFleet&gt;<BR ALIGN="LEFT"/>-currentFleet : VehicleFleet<BR ALIGN="LEFT"/>-fleetFactories : Map&lt;VehicleFleet, FleetFactory&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+FleetManager()<BR ALIGN="LEFT"/>+addFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+removeFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+addFleet(fleet : VehicleFleet, factory : FleetFactory) : void<BR ALIGN="LEFT"/>+getFleetFactory(fleet : VehicleFleet) : FleetFactory<BR ALIGN="LEFT"/>+getFleets() : List&lt;VehicleFleet&gt;<BR ALIGN="LEFT"/>+findFleet(fleetID : String) : VehicleFleet<BR ALIGN="LEFT"/>+setCurrentFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+getCurrentFleet() : VehicleFleet<BR ALIGN="LEFT"/>+getFleetCount() : int<BR ALIGN="LEFT"/>+hasFleet(fleetID : String) : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ListCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>ListCommand</B></TD></TR><TR><TD ALIGN="LEFT">-invoker : CommandInvoker<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ListCommand(invoker : CommandInvoker)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RedoCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>RedoCommand</B></TD></TR><TR><TD ALIGN="LEFT">-invoker : CommandInvoker<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+RedoCommand(invoker : CommandInvoker)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SetCurrentFleetCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>SetCurrentFleetCommand</B></TD></TR><TR><TD ALIGN="LEFT">-manager : FleetManager<BR ALIGN="LEFT"/>-fleetID : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+SetCurrentFleetCommand(manager : FleetManager, fleetID : String)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ShowAllFleetsCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>ShowAllFleetsCommand</B></TD></TR><TR><TD ALIGN="LEFT">-manager : FleetManager<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ShowAllFleetsCommand(manager : FleetManager)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ShowFleetCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>ShowFleetCommand</B></TD></TR><TR><TD ALIGN="LEFT">-manager : FleetManager<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ShowFleetCommand(manager : FleetManager)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
UndoCommand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>UndoCommand</B></TD></TR><TR><TD ALIGN="LEFT">-invoker : CommandInvoker<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+UndoCommand(invoker : CommandInvoker)<BR ALIGN="LEFT"/>+execute() : void<BR ALIGN="LEFT"/>+displayName() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ListCommand -> BaseCommand [arrowhead=empty];
RedoCommand -> BaseCommand [arrowhead=empty];
SetCurrentFleetCommand -> BaseCommand [arrowhead=empty];
ShowAllFleetsCommand -> BaseCommand [arrowhead=empty];
ShowFleetCommand -> BaseCommand [arrowhead=empty];
UndoCommand -> BaseCommand [arrowhead=empty];
ListCommand -> CommandInvoker [arrowhead=open, label="invoker", headlabel="1", taillabel="0..*", labeldistance=2];
RedoCommand -> CommandInvoker [arrowhead=open, label="invoker", headlabel="1", taillabel="0..*", labeldistance=2];
SetCurrentFleetCommand -> FleetManager [arrowhead=open, label="manager", headlabel="1", taillabel="0..*", labeldistance=2];
ShowAllFleetsCommand -> FleetManager [arrowhead=open, label="manager", headlabel="1", taillabel="0..*", labeldistance=2];
ShowFleetCommand -> FleetManager [arrowhead=open, label="manager", headlabel="1", taillabel="0..*", labeldistance=2];
UndoCommand -> CommandInvoker [arrowhead=open, label="invoker", headlabel="1", taillabel="0..*", labeldistance=2];
}