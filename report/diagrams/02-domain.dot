digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.8", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Domain and fleet creation\nSolid hollow triangle: inheritance | Dashed hollow triangle: realization\nSolid arrow: stored reference | Dashed open arrow: dependency / create"];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.75, color="#334155"];
DeliveryVanFleet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>DeliveryVanFleet</B></TD></TR><TR><TD ALIGN="LEFT">-VAN_DRIVER_ROLE : int = 1 {readOnly}<BR ALIGN="LEFT"/>-COURIER_DRIVER_ROLE : int = 2 {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+DeliveryVanFleet(fleetID : String)<BR ALIGN="LEFT"/>+updateDriverRole() : void<BR ALIGN="LEFT"/>+showFleet() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DeliveryVanFleetFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>DeliveryVanFleetFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createFleet(fleetID : String) : VehicleFleet<BR ALIGN="LEFT"/>+getType() : String<BR ALIGN="LEFT"/>+getFleetTypeName() : String<BR ALIGN="LEFT"/>+getDriverRoleName(role : int) : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Driver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>Driver</B></TD></TR><TR><TD ALIGN="LEFT">-driverID : String<BR ALIGN="LEFT"/>-driverName : String<BR ALIGN="LEFT"/>-role : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+Driver(driverID : String)<BR ALIGN="LEFT"/>+getDriverID() : String<BR ALIGN="LEFT"/>+getRole() : int<BR ALIGN="LEFT"/>+setRole(role : int) : void<BR ALIGN="LEFT"/>+getName() : String<BR ALIGN="LEFT"/>+setName(name : String) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DriverFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>DriverFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createDriver(driverID : String, driverName : String) : Driver<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FleetFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8">«interface»<BR/><B>FleetFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createFleet(fleetID : String) : VehicleFleet<BR ALIGN="LEFT"/>+getType() : String<BR ALIGN="LEFT"/>+getFleetTypeName() : String<BR ALIGN="LEFT"/>+getDriverRoleName(role : int) : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FleetFactoryRegistry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>FleetFactoryRegistry</B></TD></TR><TR><TD ALIGN="LEFT">-factories : Map&lt;String, FleetFactory&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+FleetFactoryRegistry()<BR ALIGN="LEFT"/>+registerFactory(factory : FleetFactory) : void<BR ALIGN="LEFT"/>+getFactory(type : String) : FleetFactory<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FleetManager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>FleetManager</B></TD></TR><TR><TD ALIGN="LEFT">-fleets : List&lt;VehicleFleet&gt;<BR ALIGN="LEFT"/>-currentFleet : VehicleFleet<BR ALIGN="LEFT"/>-fleetFactories : Map&lt;VehicleFleet, FleetFactory&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+FleetManager()<BR ALIGN="LEFT"/>+addFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+removeFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+addFleet(fleet : VehicleFleet, factory : FleetFactory) : void<BR ALIGN="LEFT"/>+getFleetFactory(fleet : VehicleFleet) : FleetFactory<BR ALIGN="LEFT"/>+getFleets() : List&lt;VehicleFleet&gt;<BR ALIGN="LEFT"/>+findFleet(fleetID : String) : VehicleFleet<BR ALIGN="LEFT"/>+setCurrentFleet(fleet : VehicleFleet) : void<BR ALIGN="LEFT"/>+getCurrentFleet() : VehicleFleet<BR ALIGN="LEFT"/>+getFleetCount() : int<BR ALIGN="LEFT"/>+hasFleet(fleetID : String) : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
FleetUtil [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>FleetUtil</B></TD></TR><TR><TD ALIGN="LEFT">+findDriver(fleet : VehicleFleet, driverID : String) : Driver {static}<BR ALIGN="LEFT"/>+indexOfDriver(fleet : VehicleFleet, driverID : String) : int {static}<BR ALIGN="LEFT"/>+getAllDrivers(fleet : VehicleFleet) : List&lt;Driver&gt; {static}<BR ALIGN="LEFT"/>+restoreDriverOrder(fleet : VehicleFleet, order : List&lt;Driver&gt;) : void {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RefrigeratedTruckFleet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>RefrigeratedTruckFleet</B></TD></TR><TR><TD ALIGN="LEFT">-REFRIGERATED_TRUCK_DRIVER_ROLE : int = 1 {readOnly}<BR ALIGN="LEFT"/>-COLD_CHAIN_DELIVERY_DRIVER_ROLE : int = 2 {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+RefrigeratedTruckFleet(fleetID : String)<BR ALIGN="LEFT"/>+updateDriverRole() : void<BR ALIGN="LEFT"/>+showFleet() : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RefrigeratedTruckFleetFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><B>RefrigeratedTruckFleetFactory</B></TD></TR><TR><TD ALIGN="LEFT">+createFleet(fleetID : String) : VehicleFleet<BR ALIGN="LEFT"/>+getType() : String<BR ALIGN="LEFT"/>+getFleetTypeName() : String<BR ALIGN="LEFT"/>+getDriverRoleName(role : int) : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
VehicleFleet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#dcecf8"><I>VehicleFleet</I></TD></TR><TR><TD ALIGN="LEFT">-fleetID : String<BR ALIGN="LEFT"/>-fleetName : String<BR ALIGN="LEFT"/>-drivers : AbstractList<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+VehicleFleet(fleetID : String)<BR ALIGN="LEFT"/>+getFleetID() : String<BR ALIGN="LEFT"/>+getName() : String<BR ALIGN="LEFT"/>+setName(name : String) : void<BR ALIGN="LEFT"/>+addDriver(driver : Driver) : void<BR ALIGN="LEFT"/>+dropDriver(driver : Driver) : void<BR ALIGN="LEFT"/>+getDrivers() : Iterator&lt;Driver&gt;<BR ALIGN="LEFT"/>+updateDriverRole() : void {abstract}<BR ALIGN="LEFT"/>+showFleet() : void {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DeliveryVanFleet -> VehicleFleet [arrowhead=empty];
DeliveryVanFleetFactory -> FleetFactory [style=dashed, arrowhead=empty];
RefrigeratedTruckFleet -> VehicleFleet [arrowhead=empty];
RefrigeratedTruckFleetFactory -> FleetFactory [style=dashed, arrowhead=empty];
FleetFactoryRegistry -> FleetFactory [arrowhead=open, label="factories", headlabel="0..*", taillabel="0..*", labeldistance=2];
FleetManager -> FleetFactory [arrowhead=open, label="fleetFactories", headlabel="0..*", taillabel="0..*", labeldistance=2];
FleetManager -> VehicleFleet [arrowhead=open, label="currentFleet, fleetFactories, fleets", headlabel="0..*", taillabel="0..*", labeldistance=2];
VehicleFleet -> Driver [arrowhead=open, label="drivers", headlabel="0..*", taillabel="0..*", labeldistance=2];
DeliveryVanFleetFactory -> DeliveryVanFleet [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
DriverFactory -> Driver [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
RefrigeratedTruckFleetFactory -> RefrigeratedTruckFleet [arrowhead=open, style=dashed, color="#7c3aed", label="«create»"];
FleetFactory -> VehicleFleet [arrowhead=open, style=dashed, label="return type"];
FleetUtil -> VehicleFleet [arrowhead=open, style=dashed, label="static operations"];
FleetUtil -> Driver [arrowhead=open, style=dashed, label="lookup / order"];
}